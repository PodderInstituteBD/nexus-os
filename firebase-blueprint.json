{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and metadata synchronized from Firebase Auth.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string", "maxLength": 100 },
        "avatarUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["OWNER", "LEAD", "ENGINEER", "VIEWER"] },
        "title": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "fullName", "role"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Multi-turn Gemini AI assistant chat conversation thread.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "model": { "type": "string", "enum": ["gemini-3.5-flash", "gemini-3.1-pro-preview", "gemini-3.1-flash-lite"] },
        "rolePreset": { "type": "string", "enum": ["ARCHITECT", "CODER", "SECURITY_AUDITOR", "GENERAL"] },
        "systemInstruction": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "model", "rolePreset"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message in a multi-turn chat conversation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "threadId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model", "system"] },
        "content": { "type": "string", "maxLength": 20000 },
        "modelUsed": { "type": "string" },
        "tokensUsed": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "threadId", "userId", "role", "content", "createdAt"]
    },
    "LiveTask": {
      "title": "LiveTask",
      "description": "Real-time task persisted in Firestore with subtasks and comments.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "teamId": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string", "maxLength": 255 },
        "description": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["BACKLOG", "TODO", "IN_PROGRESS", "IN_REVIEW", "DONE", "BLOCKED"] },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"] },
        "labels": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "status", "priority"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles managed directly by authenticated owners."
    },
    "/users/{userId}/chatThreads/{threadId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "User-specific multi-turn Gemini chat threads."
    },
    "/users/{userId}/chatThreads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Individual messages in a user's multi-turn chat thread."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/LiveTask" },
      "description": "Personal and cloud-synchronized real-time tasks."
    }
  }
}
